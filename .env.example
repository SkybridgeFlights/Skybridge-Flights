# Flightradar24 API (Explorer plan or higher)
# Get a key at: https://fr24api.flightradar24.com
FLIGHTRADAR24_API_KEY=
# 'auto' (default) uses FR24 when key present, falls back to OpenSky.
# Set to 'opensky' to always use OpenSky, or 'fr24' to force FR24.
FLIGHT_TRACKER_PRIMARY_PROVIDER=auto
# Live position cache duration in ms (default 30 000 — 30 s)
FR24_LIVE_CACHE_MS=30000
# Details / track cache duration in ms (default 300 000 — 5 min)
FR24_DETAILS_CACHE_MS=300000
FR24_TRACKS_CACHE_MS=300000
# Explorer-plan safe rate limit (default 8 req/min)
FR24_RATE_LIMIT_PER_MINUTE=8

