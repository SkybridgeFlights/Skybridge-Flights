# Google Analytics 4 — set your Measurement ID here.
# Copy this file to .env.local and fill in the value.
# Leave blank to disable analytics (site works fine without it).
REACT_APP_GA_MEASUREMENT_ID=
REACT_APP_ENABLE_ADS=false
REACT_APP_ENABLE_AFFILIATES=false
REACT_APP_ENABLE_SPONSORED_CONTENT=false
REACT_APP_ANALYTICS_REQUIRE_CONSENT=false
REACT_APP_ENABLE_TRACKER_WEATHER=false
REACT_APP_ENABLE_TRACKER_PLAYBACK=false
